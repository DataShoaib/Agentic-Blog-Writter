# Copy this file to .env and fill in only secrets or deployment-specific values.
# Application defaults such as CACHE_TTL_SECONDS, MAX_WORKERS, and
# MAX_REVISION_ATTEMPTS are defined and versioned in app/config.py.

# Required for text generation
GROQ_API_KEY=
# Smaller model reduces free-tier TPM pressure. Override when needed.
GROQ_MODEL=openai/gpt-oss-20b

# Optional comma-separated chat models tried in order when GROQ_MODEL keeps
# failing (timeouts, rate limits, provider errors). Defaults live in
# app/config.py under llm_fallback_models.
GROQ_FALLBACK_MODELS=

# Optional capabilities
TAVILY_API_KEY=
GOOGLE_API_KEY=
LANGSMITH_API_KEY=

# Required for JWT-based API authentication
JWT_SECRET_KEY=

# Deployment-specific. May include credentials, so do not commit it.
# Leave blank to use the in-process cache/rate-limit fallback.
REDIS_URL=
