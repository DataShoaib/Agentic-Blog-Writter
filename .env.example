# Copy this file to .env and fill in only secrets or deployment-specific values.
# Application defaults such as MAX_WORKERS and MAX_REVISION_ATTEMPTS are
# defined and versioned in app/config.py.

# Required for text generation (Gemini via LiteLLM)
GEMINI_API_KEY=
# Optional: the Groq fallback models (groq/* in the default chain) need this
GROQ_API_KEY=
# Optional override of the primary chat model (default: gemini/gemini-2.5-flash)
LLM_MODEL=
# Optional JSON array of fallback chat models, tried in order, e.g.
# ["gemini/gemini-2.5-flash-lite","groq/openai/gpt-oss-20b"]
# Defaults live in app/config.py under llm_fallback_models.
LLM_FALLBACK_MODELS=

# Optional capabilities
TAVILY_API_KEY=
# Optional for higher image quality/output rate (Gemini 2.5 Flash Image)
GOOGLE_API_KEY=
LANGSMITH_API_KEY=

# Required for JWT-based API authentication
JWT_SECRET_KEY=

# Browser origins allowed to call the API (comma-separated). Required when the
# API is deployed (e.g. Render) and the frontend runs on another host/domain.
# Local default (leave blank locally): Streamlit on :8501 and common dev ports.
CORS_ORIGINS=

# Deployment-specific. May include credentials, so do not commit it.
# Leave blank to use the in-process cache/rate-limit fallback.
REDIS_URL=

# ---------- PostgreSQL (required) ----------
# Jobs and users are stored in PostgreSQL only — there is no SQLite fallback.
# Local dev (docker-compose): postgresql://postgres:postgres@localhost:5432/blogwriter
DATABASE_URL=
